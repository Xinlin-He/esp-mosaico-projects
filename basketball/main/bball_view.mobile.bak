#include "bball_view.h"
#include "mosaico_raylib_fast.h"
#include <math.h>

#define SCREEN_W BBALL_SCREEN_W
#define SCREEN_H BBALL_SCREEN_H

// Modern mobile "shoot-out" look: no physical cabinet, just a bright glowing
// court scene with a big rim, a rounded HUD and a tray of balls.
#define UI_H 62
#define PLAY_TOP 66
#define RAMP_TOP 384
#define BASE_TOP 442
#define AIM_RANGE 140.0f
#define POWER_TO_PX 150.0f
#define POPUP_TICKS 26

static const Color C_TARGET = {236, 66, 52, 255};
static const Color C_RIM = {248, 120, 40, 255};
static const Color C_CROSS = {120, 245, 150, 255};
static const Color C_TEXT = {240, 246, 244, 255};
static const Color C_MUTE = {176, 196, 214, 255};
static const Color C_GOLD = {255, 216, 96, 255};
static const Color C_GOOD = {110, 240, 150, 255};
static const Color C_BAD = {250, 120, 120, 255};
static const Color C_FEVER = {255, 108, 160, 255};

// --- helpers --------------------------------------------------------------

static Color lerp_col(Color a, Color b, float t)
{
    if (t < 0.0f) t = 0.0f;
    else if (t > 1.0f) t = 1.0f;
    return (Color){(uint8_t)(a.r + (b.r - a.r) * t),
                   (uint8_t)(a.g + (b.g - a.g) * t),
                   (uint8_t)(a.b + (b.b - a.b) * t),
                   (uint8_t)(a.a + (b.a - a.a) * t)};
}

static void draw_centered(const char *t, int y, int size, Color c)
{
    DrawText(t, (SCREEN_W - MeasureText(t, size)) / 2, y, size, c);
}

static void draw_right(const char *t, int right_x, int y, int size, Color c)
{
    DrawText(t, right_x - MeasureText(t, size), y, size, c);
}

static void draw_glow(float x, float y, float r, Color c)
{
    for (int i = 4; i >= 1; --i) {
        float t = (float)i / 4.0f;
        DrawCircleV((Vector2){x, y}, r * (0.45f + 0.95f * t), ColorAlpha(c, 0.06f));
    }
}

static void draw_soft_shadow(float cx, float cy, float rx, float ry)
{
    for (int i = 3; i >= 1; --i) {
        float t = (float)i / 3.0f;
        DrawEllipse((int)cx, (int)cy, rx * (0.5f + 0.65f * t),
                    ry * (0.5f + 0.65f * t), ColorAlpha((Color){0, 0, 0, 255}, 0.13f));
    }
}

// Bold text with a soft glowing outline (modern arcade numerals).
static void draw_glow_text(const char *t, int x, int y, int size, Color c, Color glow)
{
    for (int dx = -2; dx <= 2; ++dx) {
        for (int dy = -2; dy <= 2; ++dy) {
            if (dx || dy) {
                DrawText(t, x + dx, y + dy, size, ColorAlpha(glow, 0.10f));
            }
        }
    }
    DrawText(t, x, y, size, c);
}

static void draw_glow_centered(const char *t, int y, int size, Color c, Color glow)
{
    draw_glow_text(t, (SCREEN_W - MeasureText(t, size)) / 2, y, size, c, glow);
}

// Shaded basketball.
static void draw_ball(float x, float y, float r)
{
    Color hi = {255, 182, 118, 255};
    Color mid = {230, 104, 36, 255};
    Color lo = {132, 46, 12, 255};
    int steps = (int)r + 2;
    for (int i = steps; i >= 1; --i) {
        float t = (float)i / (float)steps;
        Color c = (t < 0.5f) ? lerp_col(hi, mid, t * 2.0f)
                             : lerp_col(mid, lo, (t - 0.5f) * 2.0f);
        float ox = x - r * 0.16f * (1.0f - t);
        float oy = y - r * 0.18f * (1.0f - t);
        DrawCircle((int)ox, (int)oy, r * t, c);
    }
    DrawCircleV((Vector2){x - r * 0.32f, y - r * 0.34f}, r * 0.20f,
                ColorAlpha((Color){255, 246, 230, 255}, 0.7f));
    DrawCircleV((Vector2){x - r * 0.30f, y - r * 0.32f}, r * 0.09f,
                ColorAlpha((Color){255, 255, 255, 255}, 0.85f));
    Color seam = {54, 24, 8, 255};
    float th = r * 0.10f;
    if (th < 1.3f) th = 1.3f;
    DrawLineEx((Vector2){x, y - r}, (Vector2){x, y + r}, th, seam);
    DrawEllipseLines((int)x, (int)y, r * 0.98f, r * 0.33f, seam);
    DrawEllipseLines((int)x, (int)y, r * 0.40f, r * 0.98f, seam);
    DrawEllipseLines((int)x, (int)y, r * 0.74f, r * 0.90f, seam);
}

static void draw_ball_wm(float x, float y, float r, float a)
{
    DrawCircle((int)x, (int)y, r, ColorAlpha((Color){255, 150, 70, 255}, a));
    Color s = ColorAlpha((Color){255, 255, 255, 255}, a * 1.1f);
    DrawLineEx((Vector2){x, y - r}, (Vector2){x, y + r}, 2.0f, s);
    DrawLineEx((Vector2){x - r, y}, (Vector2){x + r, y}, 2.0f, s);
    DrawEllipseLines((int)x, (int)y, r * 0.5f, r, s);
    DrawEllipseLines((int)x, (int)y, r, r * 0.5f, s);
}

// --- Background scene -----------------------------------------------------

static void draw_scene(const bball_game_t *g)
{
    // 1) Dark base toward the edges (deep blue, or purple in fever).
    Color edge = g->fever ? (Color){34, 8, 52, 255} : (Color){10, 18, 62, 255};
    DrawRectangle(0, 0, SCREEN_W, SCREEN_H, edge);

    // 2) Bright cobalt radial glow from the centre of the court.
    float ccx = 240.0f, ccy = 250.0f;
    Color core = g->fever ? (Color){168, 46, 158, 255} : (Color){48, 138, 246, 255};
    for (int i = 26; i >= 1; --i) {
        float t = (float)i / 26.0f;            // 1 = outer, small = inner
        float rad = 26.0f + t * 340.0f;
        DrawCircleV((Vector2){ccx, ccy}, rad, ColorAlpha(lerp_col(core, edge, t), 0.10f));
    }

    // 3) Neon side pillars: purple (top) -> magenta (bottom), fading inward.
    Color ntop = g->fever ? (Color){230, 60, 90, 255} : (Color){150, 58, 232, 255};
    Color nbot = g->fever ? (Color){255, 110, 70, 255} : (Color){238, 72, 156, 255};
    for (int side = 0; side < 2; ++side) {
        for (int x = 0; x < 90; ++x) {
            float u = (float)x / 90.0f;
            float a = (1.0f - u);
            a = a * a * 0.9f;                  // strongest right at the edge
            int px = side ? SCREEN_W - 1 - x : x;
            DrawRectangleGradientV(px, 0, 1, SCREEN_H,
                                   ColorAlpha(ntop, a), ColorAlpha(nbot, a));
        }
    }

    // 4) Symmetric arch of ceiling lights above the hoop.
    for (int i = 0; i < 11; ++i) {
        float fx = -1.0f + 2.0f * (float)i / 10.0f;   // -1 .. 1
        float lx = 240.0f + fx * 168.0f;
        float ly = 106.0f + fx * fx * 16.0f;          // gentle upward arch
        bool on = ((g->tick / 4u + (uint32_t)i) % 9u) < 6u;
        Color lc = on ? (Color){228, 246, 255, 255} : (Color){110, 142, 186, 255};
        draw_glow(lx, ly, 7.0f, lc);
        DrawCircle((int)lx, (int)ly, 3.0f, lc);
    }

    // 5) Faint central emblem.
    float ex = 240.0f, ey = 296.0f;
    draw_ball_wm(ex, ey, 30.0f, 0.12f);
    draw_glow_centered("BASKETBALL", (int)ey + 34, 22,
                       ColorAlpha((Color){190, 224, 255, 255}, 0.42f),
                       (Color){70, 150, 255, 255});
}

// --- Hoop -----------------------------------------------------------------

// Red/white nylon net.
static void draw_net(const bball_game_t *g)
{
    float cx = g->hoop_cx, cy = g->hoop_cy;
    float rx = g->rim_rx, ry = g->rim_ry;
    float depth = ry * 3.4f;
    Color red = ColorAlpha((Color){236, 72, 72, 255}, 0.92f);
    Color white = ColorAlpha((Color){246, 249, 252, 255}, 0.95f);
    const int N = 16;
    for (int i = 0; i < N; ++i) {
        float a = 3.14159265f * (0.05f + 0.90f * (float)i / (float)(N - 1));
        float tx = cx + cosf(a) * rx, ty = cy + sinf(a) * ry;
        float bxp = cx + cosf(a) * rx * 0.28f, byp = cy + depth;
        Color c = (i & 1) ? red : white;
        Vector2 prev = {tx, ty};
        for (int s = 1; s <= 5; ++s) {
            float u = (float)s / 5.0f;
            float x = tx + (bxp - tx) * u;
            float y = ty + (byp - ty) * u + sinf(u * 3.14159f) * 3.0f;
            DrawLineEx(prev, (Vector2){x, y}, 1.6f, c);
            prev = (Vector2){x, y};
        }
    }
    for (int k = 1; k <= 3; ++k) {
        float u = (float)k / 3.0f;
        DrawEllipseLines((int)cx, (int)(cy + depth * u * 0.9f), rx * (1.0f - 0.7f * u),
                         ry * (1.0f - 0.68f * u) * 0.55f + 1.0f,
                         ColorAlpha(white, 0.7f - 0.35f * u));
    }
}

static void draw_hoop(const bball_game_t *g)
{
    float cx = g->hoop_cx, cy = g->hoop_cy;
    float rx = g->rim_rx, ry = g->rim_ry;

    // Barely-there glass board so the rim reads as "floating" (ref-style).
    float bw = rx * 2.3f, bh = rx * 1.5f;
    float bx = cx - bw / 2.0f, by = cy - bh - 2.0f;
    DrawRectangleRounded((Rectangle){bx, by, bw, bh}, 0.14f, 6,
                         ColorAlpha((Color){225, 240, 255, 255}, 0.10f));
    DrawRectangleRoundedLines((Rectangle){bx, by, bw, bh}, 0.14f, 6,
                              ColorAlpha((Color){200, 226, 255, 255}, 0.30f));
    float tw = bw * 0.36f, th = bh * 0.40f;
    DrawRectangleLinesEx((Rectangle){cx - tw / 2.0f, cy - bh * 0.66f, tw, th}, 2.0f,
                         ColorAlpha(C_TARGET, 0.7f));

    draw_net(g);

    if (g->fever) {
        draw_glow(cx, cy, rx + 8.0f, C_FEVER);
    }
    Color rim = g->fever ? C_FEVER : C_RIM;
    Color rim_dk = lerp_col(rim, (Color){40, 14, 8, 255}, 0.5f);
    Color rim_hi = lerp_col(rim, (Color){255, 244, 214, 255}, 0.65f);
    DrawEllipse((int)cx, (int)(cy - 2.0f), rx, ry, rim_dk);
    DrawEllipse((int)cx, (int)cy, rx, ry, rim);
    DrawEllipse((int)cx, (int)cy, rx - 3.0f, ry - 2.0f,
                g->fever ? (Color){70, 16, 44, 255} : (Color){30, 20, 16, 255});
    for (int a = 8; a <= 172; a += 8) {
        float r0 = (float)a * 3.14159265f / 180.0f;
        float r1 = (float)(a + 8) * 3.14159265f / 180.0f;
        DrawLineEx((Vector2){cx + cosf(r0) * rx, cy + sinf(r0) * ry},
                   (Vector2){cx + cosf(r1) * rx, cy + sinf(r1) * ry}, 3.0f, rim_hi);
    }
}

// --- Aiming aids ----------------------------------------------------------

static void draw_crosshair(const bball_game_t *g, Color color)
{
    float x = 240.0f + g->aim * AIM_RANGE;
    float y = g->hoop_cy;
    draw_glow(x, y, 12.0f, color);
    DrawCircleLines((int)x, (int)y, 13.0f, color);
    DrawCircleLines((int)x, (int)y, 12.0f, color);
    DrawLineEx((Vector2){x - 20, y}, (Vector2){x - 6, y}, 2.0f, color);
    DrawLineEx((Vector2){x + 6, y}, (Vector2){x + 20, y}, 2.0f, color);
    DrawLineEx((Vector2){x, y - 20}, (Vector2){x, y - 6}, 2.0f, color);
    DrawLineEx((Vector2){x, y + 6}, (Vector2){x, y + 20}, 2.0f, color);
    DrawCircle((int)x, (int)y, 2.0f, color);
}

static void draw_power_meter(const bball_game_t *g)
{
    const float x = 430.0f, w = 18.0f, top = 120.0f, h = 176.0f;
    const float bottom = top + h;
    DrawRectangleRounded((Rectangle){x - 4, top - 6, w + 8, h + 12}, 0.9f, 8,
                         ColorAlpha((Color){8, 20, 40, 255}, 0.7f));
    float tol = g->rim_ry / POWER_TO_PX;
    float zlo = g->ideal_power - tol, zhi = g->ideal_power + tol;
    DrawRectangleRounded((Rectangle){x, bottom - zhi * h, w, (zhi - zlo) * h}, 0.8f, 6,
                         ColorAlpha(C_GOOD, 0.5f));
    float yv = bottom - g->power * h;
    draw_glow(x + w * 0.5f, yv + (bottom - yv) * 0.5f, 10.0f, C_CROSS);
    DrawRectangleRounded((Rectangle){x + 2, yv, w - 4, bottom - yv}, 0.8f, 6,
                         ColorAlpha(C_CROSS, 0.9f));
    DrawRectangleRoundedLines((Rectangle){x - 4, top - 6, w + 8, h + 12}, 0.9f, 8, C_MUTE);
}

static void draw_popup(const bball_game_t *g)
{
    if (g->popup_timer <= 0) return;
    float frac = (float)g->popup_timer / (float)POPUP_TICKS;
    int y = (int)(g->popup_y - (1.0f - frac) * 26.0f);
    if (g->popup_kind == BBALL_SHOT_MADE) {
        const char *txt = TextFormat("+%u", g->popup_points);
        draw_glow_text(txt, (int)g->popup_x - MeasureText(txt, 26) / 2, y, 26,
                       ColorAlpha(g->fever ? C_FEVER : C_GOOD, frac),
                       (Color){255, 255, 255, 255});
    } else {
        DrawText("MISS", (int)g->popup_x - MeasureText("MISS", 20) / 2, y, 20,
                 ColorAlpha(C_BAD, frac));
    }
}

// --- Ball tray + hex floor ------------------------------------------------

static void draw_tray(const bball_game_t *g)
{
    // Sloped return tray.
    float tl = 120.0f, tr = SCREEN_W - 120.0f;
    float bl = 20.0f, br = SCREEN_W - 20.0f;
    Color top = g->fever ? (Color){70, 22, 70, 255} : (Color){36, 96, 190, 255};
    Color bot = g->fever ? (Color){110, 32, 74, 255} : (Color){22, 58, 140, 255};
    for (int y = RAMP_TOP; y < BASE_TOP; ++y) {
        float u = (float)(y - RAMP_TOP) / (float)(BASE_TOP - RAMP_TOP);
        float l = tl + (bl - tl) * u, r = tr + (br - tr) * u;
        DrawRectangle((int)l, y, (int)(r - l), 1, lerp_col(top, bot, u));
    }
    DrawLineEx((Vector2){tl, RAMP_TOP}, (Vector2){bl, BASE_TOP}, 4.0f,
               ColorAlpha((Color){255, 255, 255, 255}, 0.5f));
    DrawLineEx((Vector2){tr, RAMP_TOP}, (Vector2){br, BASE_TOP}, 4.0f,
               ColorAlpha((Color){255, 255, 255, 255}, 0.5f));

    // Hex-mesh base panel.
    DrawRectangle(0, BASE_TOP, SCREEN_W, SCREEN_H - BASE_TOP, (Color){26, 30, 40, 255});
    for (int row = 0; row < 3; ++row) {
        for (int i = -1; i < SCREEN_W / 24 + 1; ++i) {
            float hx = (float)i * 24.0f + ((row & 1) ? 12.0f : 0.0f);
            float hy = (float)BASE_TOP + 8.0f + (float)row * 13.0f;
            DrawPolyLines((Vector2){hx, hy}, 6, 10.0f, 90.0f,
                          ColorAlpha((Color){120, 140, 168, 255}, 0.5f));
        }
    }

    // A row of spare balls on the tray.
    const float bx[5] = {56.0f, 124.0f, 240.0f, SCREEN_W - 124.0f, SCREEN_W - 56.0f};
    for (int i = 0; i < 5; ++i) {
        if (i == 2 && (g->phase == ARC_AIM || g->phase == ARC_TITLE ||
                       g->phase == ARC_OVER)) {
            continue; // centre slot is the ready ball
        }
        draw_soft_shadow(bx[i], 418.0f, 13.0f, 4.0f);
        draw_ball(bx[i], 408.0f, 12.0f);
    }
}

static void draw_ready_ball(const bball_game_t *g)
{
    float lift = (g->phase == ARC_AIM) ? g->power * 10.0f : 0.0f;
    draw_soft_shadow(g->ball_x, g->ball_y + g->ball_r * 0.9f, g->ball_r * 1.05f,
                     g->ball_r * 0.34f);
    draw_ball(g->ball_x, g->ball_y - lift, g->ball_r);
}

// --- HUD ------------------------------------------------------------------

static void draw_icon_badge(int cx, int cy, Color ring)
{
    draw_glow((float)cx, (float)cy, 15.0f, ring);
    DrawCircle(cx, cy, 15.0f, (Color){12, 26, 52, 255});
    DrawCircleLines(cx, cy, 15.0f, ring);
    DrawCircleLines(cx, cy, 14.0f, ring);
}

static void draw_hud(const bball_game_t *g)
{
    DrawRectangleRounded((Rectangle){6, 4, SCREEN_W - 12, UI_H - 6}, 0.5f, 8,
                         ColorAlpha((Color){8, 22, 46, 255}, 0.82f));
    DrawRectangleRoundedLines((Rectangle){6, 4, SCREEN_W - 12, UI_H - 6}, 0.5f, 8,
                              ColorAlpha((Color){90, 150, 240, 255}, 0.7f));

    // Left: best.
    draw_icon_badge(34, 30, C_GOLD);
    draw_ball_wm(34.0f, 30.0f, 8.0f, 0.9f);
    DrawText("BEST", 54, 12, 10, C_MUTE);
    draw_glow_text(TextFormat("%lu", (unsigned long)g->best), 54, 24, 22, C_GOLD,
                   (Color){255, 180, 60, 255});

    // Centre: score (big).
    DrawText("SCORE", (SCREEN_W - MeasureText("SCORE", 10)) / 2, 8, 10, C_MUTE);
    draw_glow_centered(TextFormat("%lu", (unsigned long)g->score), 20, 34, C_TEXT,
                       (Color){80, 180, 255, 255});

    // Right: time.
    uint16_t secs = bball_game_seconds_left(g);
    bool urgent = g->fever || secs <= 10;
    draw_icon_badge(SCREEN_W - 34, 30, urgent ? C_FEVER : C_CROSS);
    DrawLineEx((Vector2){SCREEN_W - 34, 30}, (Vector2){SCREEN_W - 34, 23}, 2.0f, C_TEXT);
    DrawLineEx((Vector2){SCREEN_W - 34, 30}, (Vector2){SCREEN_W - 28, 30}, 2.0f, C_TEXT);
    draw_right("TIME", SCREEN_W - 54, 12, 10, C_MUTE);
    const char *ts = TextFormat("%u", secs);
    draw_glow_text(ts, SCREEN_W - 54 - MeasureText(ts, 22), 24, 22,
                   urgent ? C_FEVER : C_TEXT, (Color){80, 180, 255, 255});

    // Award banner under the HUD.
    if (g->fever) {
        draw_glow_centered("FEVER TIME  x2", UI_H + 4, 18, C_FEVER,
                           (Color){255, 80, 140, 255});
    } else if (g->streak >= 3) {
        draw_glow_centered(TextFormat("PERFECT!  COMBO x%u", g->streak), UI_H + 4, 16,
                           C_GOLD, (Color){255, 160, 40, 255});
    } else if (g->streak >= 2) {
        draw_glow_centered(TextFormat("COMBO x%u", g->streak), UI_H + 4, 16, C_GOOD,
                           (Color){80, 220, 120, 255});
    }
    // Distance / value tag.
    if (g->phase == ARC_AIM || g->phase == ARC_FLIGHT) {
        const char *dl = (g->distance == BBALL_DIST_NEAR) ? "CLOSE"
                       : (g->distance == BBALL_DIST_MID) ? "MID" : "DEEP";
        DrawText(TextFormat("%s  %uPT", dl, g->points), 12, RAMP_TOP - 20, 12, C_MUTE);
    }
    DrawText(TextFormat("%u/%u", g->makes, g->attempts), SCREEN_W - 60, RAMP_TOP - 20,
             12, C_MUTE);
}

// --- Side buttons + cards -------------------------------------------------

static void draw_side_buttons(void)
{
    DrawCircle(22, SCREEN_H - 24, 14.0f, (Color){40, 70, 140, 255});
    DrawCircleLines(22, SCREEN_H - 24, 14.0f, ColorAlpha(C_TEXT, 0.7f));
    DrawText("?", 18, SCREEN_H - 32, 18, C_TEXT);
    DrawCircle(SCREEN_W - 22, SCREEN_H - 24, 14.0f, (Color){40, 70, 140, 255});
    DrawCircleLines(SCREEN_W - 22, SCREEN_H - 24, 14.0f, ColorAlpha(C_TEXT, 0.7f));
    DrawRectangle(SCREEN_W - 26, SCREEN_H - 31, 3, 14, C_TEXT);
    DrawRectangle(SCREEN_W - 20, SCREEN_H - 31, 3, 14, C_TEXT);
}

static void draw_panel(int y, int h, Color accent)
{
    DrawRectangleRounded((Rectangle){54, (float)y, 372, (float)h}, 0.16f, 10,
                         ColorAlpha((Color){8, 22, 46, 255}, 0.92f));
    DrawRectangleRoundedLines((Rectangle){54, (float)y, 372, (float)h}, 0.16f, 10, accent);
}

static void draw_button(const char *text, int y, int size, Color accent)
{
    int tw = MeasureText(text, size);
    int bw = tw + 48, bx = (SCREEN_W - bw) / 2;
    DrawRectangleRounded((Rectangle){(float)bx, (float)y, (float)bw, (float)(size + 18)},
                         0.6f, 8, accent);
    DrawText(text, (SCREEN_W - tw) / 2, y + 9, size, (Color){8, 20, 14, 255});
}

static void draw_title_card(void)
{
    draw_panel(126, 236, C_RIM);
    draw_glow_centered("ARCADE HOOPS", 146, 38, C_TEXT, (Color){80, 180, 255, 255});
    draw_centered("60s SHOOT-OUT  -  BEAT YOUR BEST", 194, 14, C_GOLD);
    draw_centered("A / D  aim     F  shoot", 224, 16, C_MUTE);
    draw_centered("Streak x3 = PERFECT   Final 20s = FEVER x2", 258, 13, C_FEVER);
    draw_button("PRESS ENTER / TAP", 300, 16, C_RIM);
}

static void draw_pause_card(void)
{
    draw_panel(184, 116, C_GOLD);
    draw_glow_centered("PAUSED", 206, 34, C_TEXT, (Color){80, 180, 255, 255});
    draw_centered("Press P to resume", 256, 15, C_MUTE);
}

static void draw_over_card(const bball_game_t *g)
{
    bool nb = g->score > 0 && g->score >= g->best;
    Color accent = nb ? C_GOLD : C_RIM;
    draw_panel(120, 244, accent);
    draw_glow_centered("TIME UP", 140, 34, accent, (Color){80, 180, 255, 255});
    draw_glow_centered(TextFormat("SCORE  %lu", (unsigned long)g->score), 184, 26,
                       C_TEXT, (Color){80, 180, 255, 255});
    if (nb) {
        draw_centered("NEW BEST!", 218, 18, C_GOLD);
    } else {
        draw_centered(TextFormat("BEST  %lu", (unsigned long)g->best), 218, 16, C_MUTE);
    }
    draw_centered(TextFormat("makes %u/%u   streak %u", g->makes, g->attempts,
                             g->longest_streak), 246, 14, C_MUTE);
    draw_button("TAP / ENTER TO PLAY AGAIN", 300, 15, accent);
}

// --- Top-level render -----------------------------------------------------

void bball_view_render(const bball_game_t *game)
{
    if (!game) return;
    BeginDrawing();

    draw_scene(game);
    draw_hoop(game);

    bool aiming = game->phase == ARC_AIM;
    if (aiming) {
        draw_crosshair(game, game->fever ? C_GOLD : C_CROSS);
        draw_power_meter(game);
    } else if (game->phase == ARC_FLIGHT) {
        draw_ball(game->ball_x, game->ball_y, game->ball_r);
    }
    draw_popup(game);

    draw_tray(game);
    if (aiming || game->phase == ARC_TITLE || game->phase == ARC_OVER) {
        draw_ready_ball(game);
    }

    draw_hud(game);
    draw_side_buttons();

    if (game->phase == ARC_TITLE) {
        draw_title_card();
    } else if (game->phase == ARC_PAUSED) {
        draw_pause_card();
    } else if (game->phase == ARC_OVER) {
        draw_over_card(game);
    }

    if (game->flash && game->outcome == BBALL_SHOT_MADE && (game->flash & 1U)) {
        DrawRectangleRoundedLines((Rectangle){3, 3, SCREEN_W - 6, SCREEN_H - 6}, 0.05f,
                                  8, game->fever ? C_FEVER : C_GOOD);
    }
    EndDrawing();
}
