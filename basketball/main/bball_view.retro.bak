#include "bball_view.h"
#include "mosaico_raylib_fast.h"
#include <math.h>

#define SCREEN_W BBALL_SCREEN_W
#define SCREEN_H BBALL_SCREEN_H

// The whole screen is one upright arcade basketball cabinet, seen head-on:
//   marquee (LED scoreboard)  ->  steel tube frame (beam + two columns)
//   ->  backboard + rim + net inside a wire cage  ->  ball-return ramp
//   ->  base panel with coin slot / start button.
#define HEADER_H 72        // marquee height
#define BEAM_BOT 92        // bottom of the top cross beam
#define COL_W 28           // steel column width
#define PLAY_TOP 92        // top of the caged playfield
#define RAMP_TOP 380       // top edge of the ball-return ramp
#define BASE_TOP 452       // top of the base/control panel
#define AIM_RANGE 140.0f
#define POWER_TO_PX 150.0f
#define POPUP_TICKS 26

// --- Palette --------------------------------------------------------------
static const Color C_STEEL = {150, 160, 178, 255};
static const Color C_EDGE = {205, 214, 228, 255};
static const Color C_FRAME = {200, 52, 56, 255};   // red powder-coated tube
static const Color C_BULB_ON = {255, 240, 158, 255};
static const Color C_BULB_OFF = {96, 90, 54, 255};
// LED digits.
static const Color C_LED_BG = {12, 8, 8, 255};
static const Color C_LED_ON = {255, 66, 52, 255};
static const Color C_LED_OFF = {54, 18, 16, 255};
static const Color C_LED_TIME = {96, 236, 156, 255};
static const Color C_LED_BEST = {255, 196, 70, 255};
// Playfield / hoop.
static const Color C_TARGET = {216, 66, 48, 255};
static const Color C_RIM = {236, 104, 34, 255};
// UI text / feedback.
static const Color C_CROSS_H = {96, 232, 138, 255};
static const Color C_TEXT = {236, 242, 238, 255};
static const Color C_MUTE = {150, 166, 178, 255};
static const Color C_PANEL = {12, 18, 28, 236};
static const Color C_GOLD = {245, 214, 120, 255};
static const Color C_GOOD = {96, 232, 138, 255};
static const Color C_BAD = {247, 122, 122, 255};
static const Color C_FEVER = {255, 96, 128, 255};

// --- Small helpers --------------------------------------------------------

static Color lerp_col(Color a, Color b, float t)
{
    if (t < 0.0f) t = 0.0f;
    else if (t > 1.0f) t = 1.0f;
    return (Color){(uint8_t)(a.r + (b.r - a.r) * t),
                   (uint8_t)(a.g + (b.g - a.g) * t),
                   (uint8_t)(a.b + (b.b - a.b) * t),
                   (uint8_t)(a.a + (b.a - a.a) * t)};
}

static void draw_centered(const char *text, int y, int size, Color color)
{
    DrawText(text, (SCREEN_W - MeasureText(text, size)) / 2, y, size, color);
}

static void draw_right(const char *text, int right_x, int y, int size, Color color)
{
    DrawText(text, right_x - MeasureText(text, size), y, size, color);
}

static void draw_soft_shadow(float cx, float cy, float rx, float ry)
{
    for (int i = 3; i >= 1; --i) {
        float t = (float)i / 3.0f;
        DrawEllipse((int)cx, (int)cy, rx * (0.5f + 0.65f * t),
                    ry * (0.5f + 0.65f * t), ColorAlpha((Color){0, 0, 0, 255}, 0.11f));
    }
}

static void draw_glow(float x, float y, float r, Color c)
{
    for (int i = 4; i >= 1; --i) {
        float t = (float)i / 4.0f;
        DrawCircleV((Vector2){x, y}, r * (0.45f + 0.95f * t), ColorAlpha(c, 0.055f));
    }
}

// Round steel tube: cylindrical shading (dark edges, bright centre).
static void draw_tube_v(int x, int w, int y0, int y1, Color base)
{
    Color dk = lerp_col(base, (Color){0, 0, 0, 255}, 0.55f);
    Color br = lerp_col(base, (Color){255, 255, 255, 255}, 0.5f);
    for (int i = 0; i < w; ++i) {
        float s = sinf((float)i / (float)(w - 1) * 3.14159265f);
        DrawRectangle(x + i, y0, 1, y1 - y0, lerp_col(dk, br, s));
    }
}

static void draw_tube_h(int y, int h, int x0, int x1, Color base)
{
    Color dk = lerp_col(base, (Color){0, 0, 0, 255}, 0.55f);
    Color br = lerp_col(base, (Color){255, 255, 255, 255}, 0.5f);
    for (int i = 0; i < h; ++i) {
        float s = sinf((float)i / (float)(h - 1) * 3.14159265f);
        DrawRectangle(x0, y + i, x1 - x0, 1, lerp_col(dk, br, s));
    }
}

// --- LED (7-segment) scoreboard ------------------------------------------

static void seg_rect(int x, int y, int w, int h, bool on, Color on_c, Color off_c)
{
    if (on) {
        DrawRectangle(x - 1, y - 1, w + 2, h + 2, ColorAlpha(on_c, 0.32f));
        DrawRectangle(x, y, w, h, on_c);
    } else {
        DrawRectangle(x, y, w, h, off_c);
    }
}

static void draw_led_digit(int x, int y, int w, int h, int t, int d,
                           Color on, Color off)
{
    static const unsigned char seg[10] = {
        126, 48, 109, 121, 51, 91, 95, 112, 127, 123,
    };
    unsigned char m = (d >= 0 && d <= 9) ? seg[d] : 0;
    int vlen = (h - 3 * t) / 2;
    if (vlen < 1) {
        vlen = 1;
    }
    int mid = y + t + vlen;
    seg_rect(x + t, y, w - 2 * t, t, m & 64, on, off);
    seg_rect(x, y + t, t, vlen, m & 2, on, off);
    seg_rect(x + w - t, y + t, t, vlen, m & 32, on, off);
    seg_rect(x + t, mid, w - 2 * t, t, m & 1, on, off);
    seg_rect(x, mid + t, t, vlen, m & 4, on, off);
    seg_rect(x + w - t, mid + t, t, vlen, m & 16, on, off);
    seg_rect(x + t, y + h - t, w - 2 * t, t, m & 8, on, off);
}

static void draw_led_number(int right_x, int y, int w, int h, int t, int gap,
                            unsigned value, int min_digits, Color on, Color off)
{
    int digits[8];
    int n = 0;
    unsigned v = value;
    do {
        digits[n++] = (int)(v % 10u);
        v /= 10u;
    } while (v && n < 8);
    while (n < min_digits && n < 8) {
        digits[n++] = 0;
    }
    int x = right_x - w;
    for (int i = 0; i < n; ++i) {
        draw_led_digit(x, y, w, h, t, digits[i], on, off);
        x -= (w + gap);
    }
}

static void draw_marquee(const bball_game_t *g)
{
    DrawRectangleGradientV(0, 0, SCREEN_W, HEADER_H, (Color){34, 38, 52, 255},
                           (Color){22, 25, 36, 255});

    for (int x = 12; x < SCREEN_W - 8; x += 20) {
        int idx = x / 20;
        bool on = g->fever ? ((((int)(g->tick / 2) + idx) & 1) == 0)
                           : ((((int)(g->tick / 6) + idx) & 3) == 0);
        if (on) {
            draw_glow((float)x, 7.0f, 7.0f, C_BULB_ON);
        }
        DrawCircle(x, 7, 3.0f, on ? C_BULB_ON : C_BULB_OFF);
        DrawCircleV((Vector2){x - 0.8f, 6.0f}, 1.0f,
                    ColorAlpha((Color){255, 255, 255, 255}, on ? 0.9f : 0.2f));
    }

    DrawRectangleRounded((Rectangle){6, 15, SCREEN_W - 12, HEADER_H - 19}, 0.28f, 6,
                         C_LED_BG);
    DrawRectangle(10, 16, SCREEN_W - 20, 2, ColorAlpha((Color){120, 120, 140, 255}, 0.25f));

    DrawText("SCORE", 15, 17, 10, C_MUTE);
    draw_led_number(75, 30, 18, 34, 4, 3, (unsigned)g->score, 3, C_LED_ON, C_LED_OFF);

    uint16_t secs = bball_game_seconds_left(g);
    bool urgent = g->fever || secs <= 10;
    Color tled = urgent ? C_LED_ON : C_LED_TIME;
    DrawText("TIME", (SCREEN_W - MeasureText("TIME", 10)) / 2, 17, 10, C_MUTE);
    draw_led_number(SCREEN_W / 2 + 27, 28, 22, 40, 5, 4, (unsigned)secs, 2, tled,
                    C_LED_OFF);

    draw_right("BEST", SCREEN_W - 15, 17, 10, C_MUTE);
    draw_led_number(SCREEN_W - 15, 32, 16, 30, 3, 3, (unsigned)g->best, 3, C_LED_BEST,
                    C_LED_OFF);
}

// --- Animated arcade backdrop (flat front-on painted board) ---------------

// Translucent decorative basketball painted on the board.
static void draw_ball_wm(float x, float y, float r, float a)
{
    DrawCircle((int)x, (int)y, r, ColorAlpha((Color){232, 118, 46, 255}, a));
    Color s = ColorAlpha((Color){40, 20, 10, 255}, a * 1.4f);
    DrawLineEx((Vector2){x, y - r}, (Vector2){x, y + r}, 2.0f, s);
    DrawLineEx((Vector2){x - r, y}, (Vector2){x + r, y}, 2.0f, s);
    DrawEllipseLines((int)x, (int)y, r * 0.5f, r, s);
    DrawEllipseLines((int)x, (int)y, r, r * 0.5f, s);
}

// Central team-emblem artwork painted on the board (basketball + banner text).
static void draw_emblem(const bball_game_t *g, float cx, float cy)
{
    Color line = ColorAlpha(g->fever ? (Color){255, 200, 220, 255}
                                     : (Color){206, 224, 255, 255}, 0.13f);
    for (int i = 0; i < 14; ++i) {
        float a = (float)i * (6.2831853f / 14.0f) + (float)g->tick * 0.006f;
        DrawLineEx((Vector2){cx, cy},
                   (Vector2){cx + cosf(a) * 64.0f, cy + sinf(a) * 64.0f}, 2.0f, line);
    }
    DrawCircleLines((int)cx, (int)cy, 50.0f, line);
    DrawCircleLines((int)cx, (int)cy, 48.0f, line);
    draw_ball_wm(cx, cy - 4.0f, 32.0f, g->fever ? 0.16f : 0.20f);
    Color txt = ColorAlpha((Color){255, 236, 180, 255}, 0.5f);
    draw_centered("STREET", (int)cy + 28, 14, txt);
    draw_centered("BASKETBALL", (int)cy + 42, 18, txt);
}

static void draw_scene(const bball_game_t *g)
{
    // Machine body shell behind the frame.
    DrawRectangle(0, HEADER_H, SCREEN_W, SCREEN_H - HEADER_H, (Color){16, 18, 26, 255});

    int px = COL_W, pw = SCREEN_W - 2 * COL_W;
    int py = PLAY_TOP, bottom = RAMP_TOP;

    // One flat, front-on painted board; bright blue (purple during fever).
    Color bT = g->fever ? (Color){78, 16, 96, 255} : (Color){26, 54, 140, 255};
    Color bB = g->fever ? (Color){140, 30, 86, 255} : (Color){46, 104, 200, 255};
    DrawRectangleGradientV(px, py, pw, bottom - py, bT, bB);

    // Focus glow centred behind the hoop.
    float cx = g->hoop_cx, cy = g->hoop_cy;
    for (int i = 5; i >= 1; --i) {
        DrawCircleV((Vector2){cx, cy}, 40.0f * (float)i,
                    ColorAlpha(g->fever ? (Color){255, 150, 200, 255}
                                        : (Color){130, 180, 255, 255}, 0.030f));
    }

    // Central emblem artwork.
    draw_emblem(g, 240.0f, 262.0f);

    // Sweeping spotlights from the rafters (slow left-right sway).
    for (int i = 0; i < 3; ++i) {
        float ph2 = (float)i * 2.1f + (float)g->tick * 0.03f;
        float topx = px + pw * (0.28f + 0.22f * (float)i);
        float byv = (float)bottom;
        float botx = topx + sinf(ph2) * 80.0f;
        Color lc = g->fever ? (Color){255, 170, 214, 255} : (Color){190, 214, 255, 255};
        for (int y = py; y < (int)byv; ++y) {
            float t = ((float)y - (float)py) / (byv - (float)py);
            float hw = 5.0f + 46.0f * t;
            float cxp = topx + (botx - topx) * t;
            DrawRectangle((int)(cxp - hw), y, (int)(hw * 2.0f), 1,
                          ColorAlpha(lc, 0.07f * (1.0f - t * 0.4f)));
        }
    }

    // Decorative basketballs drifting slowly on the board.
    draw_ball_wm(px + 66.0f, 296.0f + sinf((float)g->tick * 0.02f) * 8.0f, 40.0f, 0.10f);
    draw_ball_wm(px + pw - 60.0f, 140.0f + sinf((float)g->tick * 0.017f + 1.7f) * 8.0f,
                 30.0f, 0.09f);

    // Tidy crowd silhouette band across the top of the board.
    DrawRectangleGradientV(px, py, pw, 30, (Color){10, 12, 24, 255},
                           ColorAlpha((Color){10, 12, 24, 255}, 0.0f));
    uint32_t seed = 0x2545F491u;
    for (int x = px + 8; x < px + pw - 6; x += 9) {
        seed = seed * 1664525u + 1013904223u;
        bool flash = ((g->tick / 3u + (seed >> 12)) % 47u) == 0u;
        uint8_t v = (uint8_t)(46 + ((seed >> 9) & 38u));
        Color c = flash ? (Color){255, 255, 255, 255}
                        : (g->fever ? (Color){(uint8_t)(v + 46), v, (uint8_t)(v + 22), 255}
                                    : (Color){v, (uint8_t)(v + 8), (uint8_t)(v + 34), 255});
        DrawCircle(x, py + 12, 2.0f, c);
        DrawCircle(x + 4, py + 20, 2.0f, c);
    }

    // Arena ceiling light bar across the very top of the board.
    for (int i = 0; i < 9; ++i) {
        float lx = (float)px + ((float)i + 0.5f) * (float)pw / 9.0f;
        draw_glow(lx, (float)py + 5.0f, 7.0f, (Color){190, 222, 255, 255});
        DrawCircle((int)lx, py + 5, 2.5f, (Color){226, 240, 255, 255});
    }

    // Scrolling LED ribbon along the bottom edge of the board.
    int ay = bottom - 18;
    DrawRectangle(px, ay, pw, 14, (Color){8, 9, 16, 255});
    DrawRectangle(px, ay, pw, 1, ColorAlpha((Color){120, 130, 150, 255}, 0.5f));
    static const Color ad[4] = {{240, 80, 70, 255}, {250, 200, 70, 255},
                                {70, 200, 120, 255}, {90, 160, 255, 255}};
    int off = (int)((g->tick * 2u) % 36u);
    int idx = 0;
    for (int x = px - 36 + off; x < px + pw; x += 36) {
        int bx0 = x + 3, bx1 = x + 30;
        if (bx0 < px) bx0 = px;
        if (bx1 > px + pw) bx1 = px + pw;
        if (bx1 > bx0) {
            DrawRectangle(bx0, ay + 3, bx1 - bx0, 8, ColorAlpha(ad[idx & 3], 0.85f));
        }
        ++idx;
    }
}

// Square wire mesh stretched across the steel frame: the safety cage that,
// together with the tube frame, keeps the balls from flying out.
static void draw_cage(void)
{
    int x0 = COL_W, x1 = SCREEN_W - COL_W;
    int y0 = BEAM_BOT, y1 = RAMP_TOP;
    Color wire = ColorAlpha((Color){218, 228, 242, 255}, 0.22f);
    Color node = ColorAlpha((Color){238, 246, 255, 255}, 0.34f);
    int sp = 30;
    for (int x = x0; x <= x1; x += sp) {
        DrawLine(x, y0, x, y1, wire);
    }
    for (int y = y0; y <= y1; y += sp) {
        DrawLine(x0, y, x1, y, wire);
    }
    // Fixings where the net ties onto the tube frame.
    for (int x = x0; x <= x1; x += sp) {
        DrawCircle(x, y0, 1.6f, node);
        DrawCircle(x, y1, 1.6f, node);
    }
    for (int y = y0 + sp; y < y1; y += sp) {
        DrawCircle(x0, y, 1.6f, node);
        DrawCircle(x1, y, 1.6f, node);
    }
}

// --- Hoop -----------------------------------------------------------------

static void draw_net(const bball_game_t *g)
{
    float cx = g->hoop_cx, cy = g->hoop_cy;
    float rx = g->rim_rx, ry = g->rim_ry;
    float depth = ry * 3.6f;
    Color net = ColorAlpha((Color){238, 242, 248, 255}, 0.9f);
    Color netd = ColorAlpha((Color){170, 180, 196, 255}, 0.8f);
    const int N = 16;
    for (int i = 0; i < N; ++i) {
        float a = 3.14159265f * (0.05f + 0.90f * (float)i / (float)(N - 1));
        float tx = cx + cosf(a) * rx;
        float ty = cy + sinf(a) * ry;
        float bx = cx + cosf(a) * rx * 0.26f;
        float by = cy + depth;
        Color c = (i & 1) ? net : netd;
        Vector2 prev = {tx, ty};
        const int segs = 5;
        for (int s = 1; s <= segs; ++s) {
            float t = (float)s / (float)segs;
            float x = tx + (bx - tx) * t;
            float y = ty + (by - ty) * t + sinf(t * 3.14159f) * 3.0f;
            DrawLineEx(prev, (Vector2){x, y}, 1.4f, c);
            prev = (Vector2){x, y};
        }
    }
    for (int k = 1; k <= 4; ++k) {
        float t = (float)k / 4.0f;
        float rx2 = rx * (1.0f - 0.72f * t);
        float ry2 = ry * (1.0f - 0.7f * t);
        float y = cy + depth * t * 0.92f;
        DrawEllipseLines((int)cx, (int)y, rx2, ry2 * 0.55f + 1.0f,
                         ColorAlpha(net, 0.7f - 0.3f * t));
    }
}

static void draw_hoop(const bball_game_t *g)
{
    float cx = g->hoop_cx, cy = g->hoop_cy;
    float rx = g->rim_rx, ry = g->rim_ry;

    // Backboard glass + metal frame, hung from the top beam by two rods.
    float bw = rx * 2.7f, bh = rx * 1.8f;
    float bx = cx - bw / 2.0f, by = cy - bh - 4.0f;
    DrawLineEx((Vector2){cx - 12, (float)BEAM_BOT}, (Vector2){cx - 12, by},
               3.0f, C_STEEL);
    DrawLineEx((Vector2){cx + 12, (float)BEAM_BOT}, (Vector2){cx + 12, by},
               3.0f, C_STEEL);

    DrawRectangleRec((Rectangle){bx - 3, by + 4, bw + 8, bh + 8},
                     ColorAlpha((Color){0, 0, 0, 255}, 0.25f));
    DrawRectangleRec((Rectangle){bx - 5, by - 5, bw + 10, bh + 10},
                     (Color){60, 66, 78, 255});
    DrawRectangleLinesEx((Rectangle){bx - 5, by - 5, bw + 10, bh + 10}, 2.0f,
                         ColorAlpha(C_EDGE, 0.7f));
    DrawRectangleGradientV((int)bx, (int)by, (int)bw, (int)bh,
                           (Color){224, 234, 244, 255}, (Color){190, 205, 222, 255});
    DrawLineEx((Vector2){bx + bw * 0.12f, by + bh}, (Vector2){bx + bw * 0.44f, by},
               6.0f, ColorAlpha((Color){255, 255, 255, 255}, 0.20f));
    DrawLineEx((Vector2){bx + bw * 0.30f, by + bh}, (Vector2){bx + bw * 0.62f, by},
               3.0f, ColorAlpha((Color){255, 255, 255, 255}, 0.14f));
    float tw = bw * 0.42f, th = bh * 0.44f;
    Rectangle tgt = {cx - tw / 2.0f, cy - bh * 0.72f, tw, th};
    DrawRectangleLinesEx((Rectangle){tgt.x + 1, tgt.y + 1, tgt.width, tgt.height}, 3.0f,
                         ColorAlpha((Color){0, 0, 0, 255}, 0.18f));
    DrawRectangleLinesEx(tgt, 3.0f, C_TARGET);
    Color bolt = (Color){206, 212, 224, 255};
    DrawCircle((int)(bx + 4), (int)(by + 4), 2.0f, bolt);
    DrawCircle((int)(bx + bw - 4), (int)(by + 4), 2.0f, bolt);
    DrawCircle((int)(bx + 4), (int)(by + bh - 4), 2.0f, bolt);
    DrawCircle((int)(bx + bw - 4), (int)(by + bh - 4), 2.0f, bolt);

    draw_net(g);

    if (g->fever) {
        draw_glow(cx, cy, rx + 6.0f, C_FEVER);
    }
    Color rim = g->fever ? C_FEVER : C_RIM;
    Color rim_dk = lerp_col(rim, (Color){20, 12, 8, 255}, 0.55f);
    Color rim_hi = lerp_col(rim, (Color){255, 240, 210, 255}, 0.6f);
    DrawEllipse((int)cx, (int)(cy - 2.0f), rx, ry, rim_dk);
    DrawEllipse((int)cx, (int)cy, rx, ry, rim);
    DrawEllipse((int)cx, (int)cy, rx - 3.0f, ry - 2.0f, (Color){26, 18, 14, 255});
    for (int a = 10; a <= 170; a += 8) {
        float r0 = (float)a * 3.14159265f / 180.0f;
        float r1 = (float)(a + 8) * 3.14159265f / 180.0f;
        DrawLineEx((Vector2){cx + cosf(r0) * rx, cy + sinf(r0) * ry},
                   (Vector2){cx + cosf(r1) * rx, cy + sinf(r1) * ry}, 2.5f, rim_hi);
    }
}

// --- Ball -----------------------------------------------------------------

static void draw_ball(float x, float y, float r)
{
    Color hi = {255, 178, 112, 255};
    Color mid = {224, 100, 34, 255};
    Color lo = {130, 46, 12, 255};
    int steps = (int)r + 2;
    for (int i = steps; i >= 1; --i) {
        float t = (float)i / (float)steps;
        Color c = (t < 0.5f) ? lerp_col(hi, mid, t * 2.0f)
                             : lerp_col(mid, lo, (t - 0.5f) * 2.0f);
        float ox = x - r * 0.16f * (1.0f - t);
        float oy = y - r * 0.18f * (1.0f - t);
        DrawCircle((int)ox, (int)oy, r * t, c);
    }
    DrawCircleV((Vector2){x - r * 0.32f, y - r * 0.34f}, r * 0.20f,
                ColorAlpha((Color){255, 244, 228, 255}, 0.7f));
    DrawCircleV((Vector2){x - r * 0.30f, y - r * 0.32f}, r * 0.09f,
                ColorAlpha((Color){255, 255, 255, 255}, 0.85f));
    Color seam = {52, 22, 8, 255};
    float th = r * 0.10f;
    if (th < 1.3f) {
        th = 1.3f;
    }
    DrawLineEx((Vector2){x, y - r}, (Vector2){x, y + r}, th, seam);
    DrawEllipseLines((int)x, (int)y, r * 0.98f, r * 0.33f, seam);
    DrawEllipseLines((int)x, (int)y, r * 0.40f, r * 0.98f, seam);
    DrawEllipseLines((int)x, (int)y, r * 0.74f, r * 0.90f, seam);
    DrawCircleLines((int)x, (int)y, r, ColorAlpha(lo, 0.7f));
}

// --- Ball-return ramp -----------------------------------------------------

static void draw_ramp(void)
{
    float tl = 150.0f, tr = SCREEN_W - 150.0f;
    float bl = COL_W - 2.0f, br = SCREEN_W - COL_W + 2.0f;
    int y0 = RAMP_TOP, y1 = BASE_TOP;
    Color top = {28, 40, 62, 255}, bot = {66, 84, 118, 255};
    for (int y = y0; y < y1; ++y) {
        float t = (float)(y - y0) / (float)(y1 - y0);
        float l = tl + (bl - tl) * t;
        float r = tr + (br - tr) * t;
        DrawRectangle((int)l, y, (int)(r - l), 1, lerp_col(top, bot, t));
    }
    DrawRectangle(SCREEN_W / 2 - 40, y0, 80, y1 - y0,
                  ColorAlpha((Color){200, 220, 255, 255}, 0.05f));
    // Horizontal grooves across the sloped tray (no perspective lines).
    for (int i = 1; i <= 4; ++i) {
        float t = (float)i / 5.0f;
        int y = y0 + (int)((y1 - y0) * t);
        float l = tl + (bl - tl) * t, r = tr + (br - tr) * t;
        DrawLine((int)l, y, (int)r, y, ColorAlpha((Color){150, 170, 200, 255}, 0.3f));
    }
    DrawLineEx((Vector2){tl, (float)y0}, (Vector2){bl, (float)y1}, 5.0f, C_STEEL);
    DrawLineEx((Vector2){tr, (float)y0}, (Vector2){br, (float)y1}, 5.0f, C_STEEL);

    // A row of spare balls resting on the tray.
    const float bx[4] = {46.0f, 92.0f, SCREEN_W - 92.0f, SCREEN_W - 46.0f};
    for (int i = 0; i < 4; ++i) {
        draw_soft_shadow(bx[i], 443.0f, 12.0f, 4.0f);
        draw_ball(bx[i], 433.0f, 11.0f);
    }
}

static void draw_ready_ball(const bball_game_t *g)
{
    float lift = (g->phase == ARC_AIM) ? g->power * 10.0f : 0.0f;
    draw_soft_shadow(g->ball_x, g->ball_y + g->ball_r * 0.9f, g->ball_r * 1.05f,
                     g->ball_r * 0.34f);
    draw_ball(g->ball_x, g->ball_y - lift, g->ball_r);
}

// --- Steel frame + base ---------------------------------------------------

static void draw_frame(void)
{
    // Two upright corner columns.
    draw_tube_v(0, COL_W, BEAM_BOT - 6, SCREEN_H, C_FRAME);
    draw_tube_v(SCREEN_W - COL_W, COL_W, BEAM_BOT - 6, SCREEN_H, C_FRAME);
    // Top cross beam over the columns.
    draw_tube_h(HEADER_H, BEAM_BOT - HEADER_H, 0, SCREEN_W, C_FRAME);
    // Corner joint bolts.
    Color bolt = C_STEEL, bhi = C_EDGE;
    int cxs[2] = {COL_W / 2, SCREEN_W - COL_W / 2};
    for (int i = 0; i < 2; ++i) {
        for (int y = BEAM_BOT + 30; y < SCREEN_H - 10; y += 90) {
            DrawCircle(cxs[i] + 1, y + 1, 3.0f, ColorAlpha((Color){0, 0, 0, 255}, 0.4f));
            DrawCircle(cxs[i], y, 3.0f, bolt);
            DrawCircleV((Vector2){cxs[i] - 1.0f, y - 1.0f}, 1.1f, bhi);
        }
    }
}

static void draw_base(void)
{
    DrawRectangleGradientV(0, BASE_TOP, SCREEN_W, SCREEN_H - BASE_TOP,
                           (Color){56, 60, 72, 255}, (Color){28, 31, 40, 255});
    DrawRectangle(0, BASE_TOP, SCREEN_W, 2, ColorAlpha(C_EDGE, 0.6f));

    // Coin slot (left).
    DrawRectangleRounded((Rectangle){60, BASE_TOP + 6, 42, 16}, 0.4f, 4,
                         (Color){14, 14, 18, 255});
    DrawRectangle(79, BASE_TOP + 9, 4, 10, (Color){198, 202, 212, 255});
    DrawText("INSERT COIN", 46, BASE_TOP + 6, 8, C_MUTE);

    // Brand plate (centre).
    draw_centered("HOOPS", BASE_TOP + 5, 20, C_GOLD);

    // Start button (right).
    DrawCircle(SCREEN_W - 78, BASE_TOP + 14, 11.0f, (Color){20, 120, 60, 255});
    DrawCircle(SCREEN_W - 78, BASE_TOP + 14, 9.0f, (Color){60, 210, 110, 255});
    DrawCircleV((Vector2){SCREEN_W - 81.0f, BASE_TOP + 11.0f}, 3.0f,
                ColorAlpha((Color){255, 255, 255, 255}, 0.7f));
    DrawText("START", SCREEN_W - 62, BASE_TOP + 9, 9, C_TEXT);
}

// --- Aiming aids ----------------------------------------------------------

static void draw_crosshair(const bball_game_t *g, Color color)
{
    float x = 240.0f + g->aim * AIM_RANGE;
    float y = g->hoop_cy;
    DrawCircleLines((int)x, (int)y, 13.0f, color);
    DrawCircleLines((int)x, (int)y, 12.0f, color);
    DrawLineEx((Vector2){x - 20, y}, (Vector2){x - 6, y}, 2.0f, color);
    DrawLineEx((Vector2){x + 6, y}, (Vector2){x + 20, y}, 2.0f, color);
    DrawLineEx((Vector2){x, y - 20}, (Vector2){x, y - 6}, 2.0f, color);
    DrawLineEx((Vector2){x, y + 6}, (Vector2){x, y + 20}, 2.0f, color);
    DrawCircle((int)x, (int)y, 2.0f, color);
}

static void draw_wind(const bball_game_t *g)
{
    if (fabsf(g->wind) < 0.6f) {
        return;
    }
    float cx = 240.0f, y = PLAY_TOP + 22.0f;
    float len = g->wind * 3.2f;
    float dir = g->wind < 0 ? -1.0f : 1.0f;
    DrawText("WIND", (int)cx - 74, (int)y - 6, 14, C_MUTE);
    float x0 = cx - 6, x1 = cx - 6 + len;
    DrawLineEx((Vector2){x0, y}, (Vector2){x1, y}, 3.0f, C_GOLD);
    DrawLineEx((Vector2){x1, y}, (Vector2){x1 - dir * 8, y - 5}, 3.0f, C_GOLD);
    DrawLineEx((Vector2){x1, y}, (Vector2){x1 - dir * 8, y + 5}, 3.0f, C_GOLD);
}

static void draw_power_meter(const bball_game_t *g)
{
    const float x = 414.0f, w = 18.0f, top = 108.0f, h = 176.0f;
    const float bottom = top + h;
    DrawRectangleRounded((Rectangle){x - 4, top - 22, w + 8, h + 30}, 0.4f, 6,
                         (Color){12, 18, 28, 235});
    DrawText("PWR", (int)x - 4, (int)top - 34, 12, C_MUTE);

    float tol = g->rim_ry / POWER_TO_PX;
    float zlo = g->ideal_power - tol, zhi = g->ideal_power + tol;
    float yzlo = bottom - zlo * h, yzhi = bottom - zhi * h;
    DrawRectangleRec((Rectangle){x, yzhi, w, yzlo - yzhi}, ColorAlpha(C_GOOD, 0.5f));

    float yv = bottom - g->power * h;
    DrawRectangleRec((Rectangle){x + 3, yv, w - 6, bottom - yv}, ColorAlpha(C_CROSS_H, 0.85f));
    DrawLineEx((Vector2){x - 3, yv}, (Vector2){x + w + 3, yv}, 3.0f, C_TEXT);
    DrawRectangleRoundedLines((Rectangle){x - 4, top - 22, w + 8, h + 30}, 0.4f, 6, C_MUTE);
}

static void draw_popup(const bball_game_t *g)
{
    if (g->popup_timer <= 0) {
        return;
    }
    float frac = (float)g->popup_timer / (float)POPUP_TICKS;
    float rise = (1.0f - frac) * 26.0f;
    int y = (int)(g->popup_y - rise);
    if (g->popup_kind == BBALL_SHOT_MADE) {
        Color c = ColorAlpha(g->fever ? C_FEVER : C_GOOD, frac);
        const char *txt = TextFormat("+%u", g->popup_points);
        DrawText(txt, (int)g->popup_x - MeasureText(txt, 24) / 2, y, 24, c);
        const char *tag = g->fever ? "FEVER!" : "SWISH";
        DrawText(tag, (int)g->popup_x - MeasureText(tag, 12) / 2, y + 24, 12,
                 ColorAlpha(C_TEXT, frac));
    } else {
        Color c = ColorAlpha(C_BAD, frac);
        DrawText("MISS", (int)g->popup_x - MeasureText("MISS", 20) / 2, y, 20, c);
    }
}

// --- Play-field status ----------------------------------------------------

static const char *dist_label(uint8_t d)
{
    switch (d) {
    case BBALL_DIST_NEAR: return "CLOSE";
    case BBALL_DIST_MID:  return "MID";
    default:              return "DEEP";
    }
}

static void draw_status(const bball_game_t *g)
{
    int row = PLAY_TOP + 2;
    if (g->fever) {
        draw_centered("* FEVER  x2 *", PLAY_TOP + 2, 16, C_FEVER);
    } else if (g->streak >= 2) {
        DrawText(TextFormat("COMBO x%u", g->streak), COL_W + 6, row, 14, C_GOOD);
        row += 18;
    }
    if (g->phase == ARC_AIM || g->phase == ARC_FLIGHT) {
        DrawText(TextFormat("%s  %uPT", dist_label(g->distance), g->points),
                 COL_W + 6, row, 13, C_MUTE);
    }
    DrawText(TextFormat("%u/%u", g->makes, g->attempts), COL_W + 6, RAMP_TOP - 18,
             12, C_MUTE);
}

// --- Cards ----------------------------------------------------------------

static void draw_panel(int y, int h, Color accent)
{
    DrawRectangleRounded((Rectangle){60, (float)y, 360, (float)h}, 0.1f, 8, C_PANEL);
    DrawRectangleRoundedLines((Rectangle){60, (float)y, 360, (float)h}, 0.1f, 8, accent);
}

static void draw_button(const char *text, int y, int size, Color accent)
{
    int tw = MeasureText(text, size);
    int bw = tw + 44;
    int bx = (SCREEN_W - bw) / 2;
    DrawRectangleRounded((Rectangle){(float)bx, (float)y, (float)bw,
                                     (float)(size + 16)}, 0.5f, 6, accent);
    DrawText(text, (SCREEN_W - tw) / 2, y + 8, size, (Color){8, 20, 14, 255});
}

static void draw_title_card(void)
{
    draw_panel(120, 244, C_RIM);
    draw_centered("ARCADE HOOPS", 138, 38, C_TEXT);
    draw_centered("60s SHOOT-OUT  -  BEAT YOUR BEST", 184, 14, C_GOLD);
    draw_centered("A / D  aim    F  shoot", 214, 16, C_MUTE);
    draw_centered("Touch: drag to aim, release to shoot", 240, 13, C_MUTE);
    draw_centered("Streak x3+ = bonus   Final 20s = FEVER x2", 262, 13, C_FEVER);
    draw_button("PRESS ENTER / TAP", 302, 16, C_RIM);
}

static void draw_pause_card(void)
{
    draw_panel(180, 120, C_GOLD);
    draw_centered("PAUSED", 200, 36, C_TEXT);
    draw_centered("Press P to resume", 252, 15, C_MUTE);
}

static void draw_over_card(const bball_game_t *g)
{
    bool new_best = g->score > 0 && g->score >= g->best;
    Color accent = new_best ? C_GOLD : C_RIM;
    draw_panel(116, 250, accent);
    draw_centered("TIME UP", 134, 34, accent);
    draw_centered(TextFormat("SCORE  %lu", (unsigned long)g->score), 180, 26, C_TEXT);
    if (new_best) {
        draw_centered("NEW BEST!", 214, 18, C_GOLD);
    } else {
        draw_centered(TextFormat("BEST  %lu", (unsigned long)g->best), 214, 16, C_MUTE);
    }
    draw_centered(TextFormat("makes %u/%u   streak %u",
                             g->makes, g->attempts, g->longest_streak), 242, 14,
                  C_MUTE);
    draw_button("TAP / ENTER TO PLAY AGAIN", 300, 15, accent);
}

// --- Top-level render -----------------------------------------------------

void bball_view_render(const bball_game_t *game)
{
    if (!game) {
        return;
    }
    BeginDrawing();

    draw_scene(game);
    draw_hoop(game);
    draw_ramp();

    bool aiming = game->phase == ARC_AIM;
    if (aiming || game->phase == ARC_TITLE || game->phase == ARC_OVER) {
        draw_ready_ball(game);
    }

    // Safety net stretched across the frame (hoop sits behind it).
    draw_cage();

    // Aiming HUD and the live ball read in front of the net.
    if (aiming) {
        draw_wind(game);
        draw_crosshair(game, game->fever ? C_GOLD : C_CROSS_H);
        draw_power_meter(game);
    } else if (game->phase == ARC_FLIGHT) {
        draw_wind(game);
        draw_ball(game->ball_x, game->ball_y, game->ball_r);
    }
    draw_popup(game);

    // Cabinet frame + base sit in front of the caged playfield.
    draw_frame();
    draw_base();
    draw_marquee(game);
    draw_status(game);

    if (game->phase == ARC_TITLE) {
        draw_title_card();
    } else if (game->phase == ARC_PAUSED) {
        draw_pause_card();
    } else if (game->phase == ARC_OVER) {
        draw_over_card(game);
    }

    if (game->flash && game->outcome == BBALL_SHOT_MADE && (game->flash & 1U)) {
        DrawRectangleLinesEx((Rectangle){2, 2, SCREEN_W - 4, SCREEN_H - 4}, 4.0f,
                             game->fever ? C_FEVER : C_GOOD);
    } else if (game->fever && (game->phase == ARC_AIM || game->phase == ARC_FLIGHT) &&
               (game->tick & 8U)) {
        DrawRectangleLinesEx((Rectangle){2, 2, SCREEN_W - 4, SCREEN_H - 4}, 3.0f,
                             ColorAlpha(C_FEVER, 0.5f));
    }
    EndDrawing();
}
