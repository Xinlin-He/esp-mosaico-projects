menu "MiniHub panel"

config MINIHUB_PANEL_HUB_USERNAME
    string "MiniHub username"
    default "admin"

config MINIHUB_PANEL_HUB_PASSWORD
    string "MiniHub password"
    default ""

config MINIHUB_PANEL_API_TOKEN
    string "MiniHub bearer token"
    default ""
    help
        Unused when the panel talks to the on-device Host with login auth off.

endmenu
