# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_OTA_DEFAULT_VIA_RECOVERY=y
CONFIG_ESP_IRIS_SYSTEM_INVENTORY=y
CONFIG_ESP_IRIS_USB_PRODUCT="ESP-Iris Mosaico Kodou Matsuri"
CONFIG_ESP_IRIS_FIRMWARE_ROLE=1
CONFIG_ESP_IRIS_PRODUCT_CONTRACT="esp-mosaico/v2"
CONFIG_ESP_IRIS_BOARD_ID="esp-mosaico"
CONFIG_ESP_IRIS_LAYOUT_ID="mosaico-retained-test-2m-v2"
CONFIG_ESP_IRIS_RECOVERY_ABI=2
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000

# Keep plain malloc() and GSP runtime buffers out of internal SRAM so QSPI
# DMA allocations (MALLOC_CAP_DMA) still fit. Mirrors the shipped
# minihub_panel memory layout on this board.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_ESP_GSP_RENDER_TASK_STACK_PSRAM=y
CONFIG_ESP_GSP_DECODE_TASK_STACK_PSRAM=y
CONFIG_ESP_GSP_ANIM_FRAME_MEMORY_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
