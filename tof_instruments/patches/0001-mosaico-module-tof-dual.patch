+
+static esp_err_t bring_up(bsp_subboard_slot_t slot, gpio_num_t xshut, uint8_t address,
+                          const mosaico_tof_config_t *config, vl53l0x_handle_t *out)
+{
+    i2c_master_bus_handle_t bus = bsp_subboard_get_i2c_bus();
+    ESP_RETURN_ON_FALSE(bus, ESP_ERR_INVALID_STATE, TAG, "subboard bus not initialized");
     ESP_RETURN_ON_ERROR(gpio_set_level(xshut, 1), TAG, "release XSHUT failed");
     vTaskDelay(pdMS_TO_TICKS(50) + 1);
 
@@ -44,12 +60,22 @@ esp_err_t mosaico_tof_new(bsp_subboard_slot_t slot, vl53l0x_handle_t *out_sensor
     vl53l0x_ref_calibration_t calibration = {0};
     ESP_GOTO_ON_ERROR(vl53l0x_create(&sensor, bus), fail, TAG, "create sensor failed");
     ESP_GOTO_ON_ERROR(vl53l0x_init(sensor), fail, TAG, "initialize sensor failed");
-    ESP_GOTO_ON_ERROR(vl53l0x_set_timing_budget(sensor, VL53L0X_DEFAULT_TIMING_BUDGET_US), fail, TAG, "set timing budget failed");
-    ESP_GOTO_ON_ERROR(vl53l0x_perform_ref_calibration(sensor, &calibration), fail, TAG, "reference calibration failed");
-    ESP_GOTO_ON_ERROR(vl53l0x_set_profile(sensor, VL53L0X_PROFILE_DEFAULT), fail, TAG, "set profile failed");
-    ESP_GOTO_ON_ERROR(vl53l0x_set_mode(sensor, VL53L0X_MODE_SINGLE), fail, TAG, "set single mode failed");
-    *out_sensor = sensor;
-    ESP_LOGI(TAG, "VL53L0X ready: slot=%s XSHUT=%d", slot == BSP_SUBBOARD_SLOT_LEFT ? "left" : "right", xshut);
+    ESP_GOTO_ON_ERROR(vl53l0x_set_timing_budget(sensor, VL53L0X_DEFAULT_TIMING_BUDGET_US),
+                      fail, TAG, "set timing budget failed");
+    ESP_GOTO_ON_ERROR(vl53l0x_perform_ref_calibration(sensor, &calibration),
+                      fail, TAG, "reference calibration failed");
+    ESP_GOTO_ON_ERROR(vl53l0x_set_profile(sensor, config->profile), fail, TAG, "set profile failed");
+    if (address != 0 && address != MOSAICO_TOF_I2C_ADDRESS_DEFAULT) {
+        ESP_GOTO_ON_ERROR(vl53l0x_set_address(sensor, bus, address), fail, TAG, "set address failed");
+    }
+    ESP_GOTO_ON_ERROR(vl53l0x_set_mode(sensor, config->mode), fail, TAG, "set mode failed");
+    if (config->start_measurement) {
+        ESP_GOTO_ON_ERROR(vl53l0x_start_measurement(sensor), fail, TAG, "start measurement failed");
+    }
+    *out = sensor;
+    ESP_LOGI(TAG, "VL53L0X ready: slot=%s XSHUT=%d address=0x%02x",
+             slot == BSP_SUBBOARD_SLOT_LEFT ? "left" : "right", (int)xshut,
+             address != 0 ? address : MOSAICO_TOF_I2C_ADDRESS_DEFAULT);
     return ESP_OK;
 
 fail:
@@ -59,3 +85,89 @@ fail:
     ESP_ERROR_CHECK_WITHOUT_ABORT(gpio_set_level(xshut, 0));
     return ret;
 }
+
+static esp_err_t open_one(bsp_subboard_slot_t slot, uint8_t address,
+                          const mosaico_tof_config_t *config, vl53l0x_handle_t *out)
+{
+    gpio_num_t xshut = GPIO_NUM_NC;
+    ESP_RETURN_ON_ERROR(configure_xshut(slot, &xshut), TAG, "configure XSHUT failed");
+    ESP_RETURN_ON_ERROR(gpio_set_level(xshut, 0), TAG, "assert XSHUT failed");
+    /* Round up so the reset pulse survives low FreeRTOS tick rates. */
+    vTaskDelay(pdMS_TO_TICKS(2) + 1);
+    return bring_up(slot, xshut, address, config, out);
+}
+
+esp_err_t mosaico_tof_close(bsp_subboard_slot_t slot, vl53l0x_handle_t sensor)
+{
+    if (!sensor) {
+        return ESP_OK;
+    }
+    esp_err_t ret = vl53l0x_destroy(sensor);
+    gpio_num_t xshut = GPIO_NUM_NC;
+    esp_err_t gpio_ret = configure_xshut(slot, &xshut);
+    if (gpio_ret == ESP_OK) {
+        gpio_ret = gpio_set_level(xshut, 0);
+    }
+    return ret != ESP_OK ? ret : gpio_ret;
+}
+
+esp_err_t mosaico_tof_open_pair(const mosaico_tof_config_t *config,
+                                vl53l0x_handle_t *left,
+                                vl53l0x_handle_t *right)
+{
+    ESP_RETURN_ON_FALSE(left || right, ESP_ERR_INVALID_ARG, TAG, "no output handle");
+    ESP_RETURN_ON_FALSE(left != right, ESP_ERR_INVALID_ARG, TAG, "output handles alias");
+    if (left) {
+        *left = NULL;
+    }
+    if (right) {
+        *right = NULL;
+    }
+    const mosaico_tof_config_t *active = config ? config : &s_single_config;
+    ESP_RETURN_ON_ERROR(check_config(active), TAG, "invalid ToF config");
+
+    i2c_master_bus_handle_t bus = bsp_subboard_get_i2c_bus();
+    ESP_RETURN_ON_FALSE(bus, ESP_ERR_INVALID_STATE, TAG, "subboard bus not initialized");
+    ESP_RETURN_ON_ERROR(bsp_power_set_codec_3v3(true), TAG, "enable module rail failed");
+    vTaskDelay(pdMS_TO_TICKS(200) + 1);
+
+    if (left && right) {
+        gpio_num_t left_xshut = GPIO_NUM_NC;
+        gpio_num_t right_xshut = GPIO_NUM_NC;
+        ESP_RETURN_ON_ERROR(configure_xshut(BSP_SUBBOARD_SLOT_LEFT, &left_xshut),
+                            TAG, "configure left XSHUT failed");
+        ESP_RETURN_ON_ERROR(configure_xshut(BSP_SUBBOARD_SLOT_RIGHT, &right_xshut),
+                            TAG, "configure right XSHUT failed");
+        ESP_RETURN_ON_ERROR(gpio_set_level(left_xshut, 0), TAG, "hold left XSHUT failed");
+        ESP_RETURN_ON_ERROR(gpio_set_level(right_xshut, 0), TAG, "hold right XSHUT failed");
+        vTaskDelay(pdMS_TO_TICKS(2) + 1);
+
+        esp_err_t ret = bring_up(BSP_SUBBOARD_SLOT_LEFT, left_xshut,
+                                 MOSAICO_TOF_I2C_ADDRESS_ALT, active, left);
+        if (ret != ESP_OK) {
+            return ret;
+        }
+        ret = bring_up(BSP_SUBBOARD_SLOT_RIGHT, right_xshut, 0, active, right);
+        if (ret != ESP_OK) {
+            ESP_ERROR_CHECK_WITHOUT_ABORT(mosaico_tof_close(BSP_SUBBOARD_SLOT_LEFT, *left));
+            *left = NULL;
+        }
+        return ret;
+    }
+
+    if (left) {
+        return open_one(BSP_SUBBOARD_SLOT_LEFT, 0, active, left);
+    }
+    return open_one(BSP_SUBBOARD_SLOT_RIGHT, 0, active, right);
+}
+
+esp_err_t mosaico_tof_new(bsp_subboard_slot_t slot, vl53l0x_handle_t *out_sensor)
+{
+    ESP_RETURN_ON_FALSE(out_sensor, ESP_ERR_INVALID_ARG, TAG, "null output handle");
+    *out_sensor = NULL;
+    ESP_RETURN_ON_FALSE(slot >= BSP_SUBBOARD_SLOT_LEFT && slot < BSP_SUBBOARD_SLOT_COUNT,
+                        ESP_ERR_INVALID_ARG, TAG, "invalid slot");
+    vl53l0x_handle_t *left = slot == BSP_SUBBOARD_SLOT_LEFT ? out_sensor : NULL;
+    vl53l0x_handle_t *right = slot == BSP_SUBBOARD_SLOT_RIGHT ? out_sensor : NULL;
+    return mosaico_tof_open_pair(NULL, left, right);
+}
