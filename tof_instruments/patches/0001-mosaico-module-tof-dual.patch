diff --git a/components/mosaico_module_tof/README.md b/components/mosaico_module_tof/README.md
index 128c534..b17d022 100644
--- a/components/mosaico_module_tof/README.md
+++ b/components/mosaico_module_tof/README.md
@@ -16,7 +16,8 @@ ESP_ERROR_CHECK(mosaico_module_mgr_release(&lease));
 ```
 
 - The bus comes from `bsp_subboard_get_i2c_bus()`, which accounts for the mainboard revision. XSHUT uses GPIO48 on the left slot and its mapped counterpart on the right.
-- Only one ToF board may be connected. Both boards would use the default address `0x29`, so simultaneous use is not supported. INT is unused.
+- `mosaico_tof_new()` supports one board. Both boards would use the default address `0x29`. INT is unused.
+- Two boards use `mosaico_tof_open_pair()`. It holds both XSHUT lines low, moves the left sensor to `0x30`, then brings the right sensor up at `0x29`. Pass `NULL` for an empty slot. Shut a sensor down with `mosaico_tof_close()`. A NULL config keeps the single-shot defaults. Continuous ranging passes `VL53L0X_PROFILE_HIGH_SPEED`, `VL53L0X_MODE_CONTINUOUS`, and `start_measurement = true`. `projects/tof_instruments` is the reference caller.
 - Initialization includes power settling and reset delays. Measurements are blocking. Serialize all operations and destruction on the same handle; do not open an already claimed sensor again.
 - `ESP_OK` indicates successful communication. Check `data.valid` before using the distance; `data.range_status` reports invalid measurement status.
 - Destroying the driver does not turn off shared power or delete the shared I²C bus.
diff --git a/components/mosaico_module_tof/include/mosaico_module_tof.h b/components/mosaico_module_tof/include/mosaico_module_tof.h
index d25c5d7..624cd63 100644
--- a/components/mosaico_module_tof/include/mosaico_module_tof.h
+++ b/components/mosaico_module_tof/include/mosaico_module_tof.h
@@ -11,17 +11,54 @@
 extern "C" {
 #endif
 
+/** Default 7-bit address. Both slots answer here until one is moved. */
+#define MOSAICO_TOF_I2C_ADDRESS_DEFAULT 0x29
+/** Address assigned to the left slot when both modules are opened together. */
+#define MOSAICO_TOF_I2C_ADDRESS_ALT     0x30
+
+/**
+ * @brief Ranging setup for mosaico_tof_open_pair().
+ *
+ * A NULL config uses VL53L0X_PROFILE_DEFAULT, VL53L0X_MODE_SINGLE, and does
+ * not start measurements. start_measurement is only valid with a continuous mode.
+ */
+typedef struct {
+    vl53l0x_profile_t profile;
+    vl53l0x_mode_t mode;
+    bool start_measurement;
+} mosaico_tof_config_t;
+
 /**
  * @brief Reset and initialize one VL53L0X module for single measurements.
  *
  * Initialize and claim the slot through mosaico_module_mgr before calling.
- * Only one ToF board may be connected: both slots share address 0x29.
- * Serialize access to the handle; read with vl53l0x_single_measure() and
- * destroy with vl53l0x_destroy() before releasing the slot.
- * On failure, out_sensor is NULL.
+ * This leaves the sensor at MOSAICO_TOF_I2C_ADDRESS_DEFAULT. Both slots share
+ * that address, so use mosaico_tof_open_pair() when two boards are connected.
+ * Serialize access to the handle. On failure, out_sensor is NULL.
  */
 esp_err_t mosaico_tof_new(bsp_subboard_slot_t slot, vl53l0x_handle_t *out_sensor);
 
+/**
+ * @brief Open one or both ToF slots on the shared I2C bus.
+ *
+ * Pass NULL for a slot that is not populated. The two output pointers must be
+ * distinct. When both are present, the left sensor is moved to
+ * MOSAICO_TOF_I2C_ADDRESS_ALT while the right sensor is held in reset, then
+ * the right sensor is brought up at MOSAICO_TOF_I2C_ADDRESS_DEFAULT.
+ * A single slot keeps the default address. On failure every output is NULL
+ * and any sensor opened by this call is shut down.
+ */
+esp_err_t mosaico_tof_open_pair(const mosaico_tof_config_t *config,
+                                vl53l0x_handle_t *left,
+                                vl53l0x_handle_t *right);
+
+/**
+ * @brief Stop one sensor and hold its XSHUT low.
+ *
+ * A NULL sensor is ignored. Shared 3V3 and the I2C bus stay up.
+ */
+esp_err_t mosaico_tof_close(bsp_subboard_slot_t slot, vl53l0x_handle_t sensor);
+
 #ifdef __cplusplus
 }
 #endif
